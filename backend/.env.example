NODE_ENV=
PORT=
FRONTEND_ORIGIN=
MONGODB_URI=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use for asymmetric signing keys; derived from SUPABASE_URL if omitted.
SUPABASE_JWKS_URL=
# Only set if this Supabase project still uses legacy HS256 JWT signing.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=incident-evidence
# Seeds sample incidents into MongoDB when the backend container starts.
SEED_DEMO_DATA=true
